{
  "name": "role-ai",
  "version": "0.1.0",
  "description": "Local-first real-time voice AI role assistant for Windows: Rust + Tauri full-duplex voice pipeline for interviewer role-play practice, meeting assistance, and live-stream presenting",
  "author": "RoleAI contributors",
  "private": true,
  "scripts": {
    "dev:tauri-ui": "vite --config vite.config.ts",
    "build:tauri-ui": "tsc -p tsconfig.tauri.json && vite build --config vite.config.ts",
    "test:tauri-ui": "vitest run --config vite.config.ts",
    "test:coverage:ui": "vitest run --config vite.config.ts --coverage",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:tauri": "cargo test --manifest-path src-tauri/Cargo.toml && npm run test:tauri-ui && node --test tests/tauri/*.test.mjs && npm run build:tauri-ui",
    "test:tauri-package": "node scripts/test-tauri-package.mjs",
    "dev:demo": "vite --config vite.demo.config.ts",
    "build:demo": "tsc -p tsconfig.tauri.json && vite build --config vite.demo.config.ts",
    "test:e2e:demo": "playwright test --config playwright.config.ts",
    "test:e2e:desktop": "node e2e/desktop/wd-smoke.mjs",
    "test:e2e:desktop:main": "node e2e/desktop/main-flow.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:video": "node scripts/demo-video.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-updater": "2.11.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wouter": "3.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "29.0.0",
    "selenium-webdriver": "4.49.0",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
