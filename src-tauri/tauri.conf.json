{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoleAI",
  "version": "0.1.0",
  "identifier": "com.aivirtualassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-ui",
    "beforeBuildCommand": "npm run build:tauri-ui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist-tauri-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../native/AudioBridge/publish/AudioBridge.exe": "audio-bridge/AudioBridge.exe",
      "../scripts/fetch-prerequisites.ps1": "prerequisite-scripts/fetch-prerequisites.ps1",
      "../scripts/install-prerequisite.ps1": "prerequisite-scripts/install-prerequisite.ps1",
      "resources/models/*.onnx": "resources/models/"
    }
  }
}
